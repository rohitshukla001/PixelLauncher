<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system wallpaper shows behind the launcher. -->
    <style name="Theme.PixelLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Settings draws its own opaque background. -->
    <style name="Theme.PixelLauncher.Settings" parent="android:Theme.Material.NoActionBar" />
</resources>
